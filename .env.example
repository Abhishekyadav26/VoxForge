TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
COINMARKETCAP_API_KEY=
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Optional: comma-separated chain if GROQ_MODEL is down/retired (used as-is)
GROQ_MODEL_FALLBACKS=openai/gpt-oss-20b,qwen/qwen3.8-27b,allam-2-7b

# --- Authentication (NextAuth email/password + Google OAuth optional) ---
# Base URL of the app (http://localhost:3000 in dev, your domain in prod)
NEXTAUTH_URL=http://localhost:3000
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
# Google OAuth (https://console.cloud.google.com → APIs & Services →
# Credentials → Create credentials → OAuth client ID → Web application).
# Authorized redirect URI must be: {NEXTAUTH_URL}/api/auth/callback/google
# Optional: leave empty to hide the Google button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Users live in the app's storage (Supabase users table, or local JSON files).
# Run supabase/migrations in the Supabase SQL editor (0001 + 0003 + 0004 for
# auth; 0004 makes password_hash nullable for Google-only accounts).
# Registration is via POST /api/auth/register or the Google button.

# Optional Supabase persistence (agents/runs). When both are set the app uses
# Supabase; otherwise it falls back to local JSON files. Use either the secret
# key (sb_secret_..., legacy service_role) or the publishable key
# (sb_publishable_..., legacy anon) — the migration includes RLS policies for
# the anon role so the publishable key works for this single-user app. Create
# the tables by running supabase/migrations/0001_init.sql in the SQL editor.
# Keep the key server-side only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
