TELEGRAM_BOT_TOKEN=
# Where alerts go UNLESS a user has bound their own Telegram chat
# (per-user binding makes each user's agents alert their own chat; see
# supabase/migrations/0005_telegram_binding.sql + /api/telegram/link +
# /api/telegram/webhook). Set the webhook with:
#   npx tsx scripts/set-telegram-webhook.ts https://your-domain.com
# For local dev Telegram needs a public URL (ngrok/cloudflared) — or leave
# unset and only use the bot via the t.me deep link + polling.
TELEGRAM_CHAT_ID=
COINMARKETCAP_API_KEY=
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Optional: comma-separated chain if GROQ_MODEL is down/retired (used as-is)
GROQ_MODEL_FALLBACKS=openai/gpt-oss-20b,qwen/qwen3.8-27b,allam-2-7b

# --- Authentication (NextAuth email/password + Google OAuth optional) ---
# Base URL of the app (http://localhost:3000 in dev, your domain in prod)
NEXTAUTH_URL=http://localhost:3000
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
# --- Cloudflare Turnstile (bot protection on register + sign-in) ---
# Dashboard: Cloudflare → Turnstile → Add widget (Managed mode), then paste.
# Both are private server-side vars (no NEXT_PUBLIC_ prefix): the site key is
# served to the login form via /api/turnstile/sitekey, the secret is used by
# lib/turnstile.ts siteverify and never leaves the server.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
# Leave both empty for local dev — verification is skipped with a warning.

# --- Password-reset email (Resend) ---
# Password reset is currently DISABLED. To enable it, set the flag below to
# true AND configure RESEND_API_KEY + PASSWORD_RESET_FROM with a domain you
# own and have verified in Resend (free mail domains like gmail.com are not
# allowed as senders). Without the key, dev logs the reset link to the server
# console; production users cannot complete a reset.
NEXT_PUBLIC_PASSWORD_RESET_ENABLED=false
RESEND_API_KEY=
PASSWORD_RESET_FROM=VoxForge <no-reply@yourdomain.com>
# Google OAuth (https://console.cloud.google.com → APIs & Services →
# Credentials → Create credentials → OAuth client ID → Web application).
# Authorized redirect URI must be: {NEXTAUTH_URL}/api/auth/callback/google
# Optional: leave empty to hide the Google button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Users live in the app's storage (Supabase users table, or local JSON files).
# Run supabase/migrations in the Supabase SQL editor (0001 + 0003 + 0004 for
# auth; 0004 makes password_hash nullable for Google-only accounts).
# 0005 adds per-user Telegram binding (telegram_chat_id / telegram_code).
# 0007 adds password reset; 0008 adds session_version (revokes sessions on
# password change). Run every migration in order.
# Registration is via POST /api/auth/register or the Google button.

# Optional Supabase persistence (agents/runs). When both are set the app uses
# Supabase; otherwise it falls back to local JSON files. Use either the secret
# key (sb_secret_..., legacy service_role) or the publishable key
# (sb_publishable_..., legacy anon) — the migration includes RLS policies for
# the anon role so the publishable key works for this single-user app. Create
# the tables by running supabase/migrations/0001_init.sql in the SQL editor.
# Keep the key server-side only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Scheduler: protects /api/cron/run-due. Generate with: openssl rand -hex 32
CRON_SECRET=
