TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
COINMARKETCAP_API_KEY=
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Optional: comma-separated chain if GROQ_MODEL is down/retired (used as-is)
GROQ_MODEL_FALLBACKS=openai/gpt-oss-20b,qwen/qwen3.8-27b,allam-2-7b
# Optional Supabase persistence (agents/runs). When both are set the app uses
# Supabase; otherwise it falls back to local JSON files. Service-role key is
# server-side only — never expose it to the client. Create the tables by
# running supabase/migrations/0001_init.sql in the Supabase SQL editor.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
